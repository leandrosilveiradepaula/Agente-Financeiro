DATABASE_URL=
POSTGRES_SSL=true

N8N_GENERATE_SQL_WEBHOOK_URL=
N8N_EXECUTE_WATSON_WEBHOOK_URL=
N8N_INTERNAL_WEBHOOK_TOKEN=

LANGGRAPH_SHADOW_ENABLED=false
LANGGRAPH_OFFICIAL_VIA_N8N=false
# direct (legacy), n8n_relay (legacy) or n8n (seven-node parallel Shadow).
# Changing transport does not authorize activation or cutover.
LANGGRAPH_SHADOW_TRANSPORT=direct
# Production HTTPS webhook path: /webhook/langgraph-shadow-parallel-v1
LANGGRAPH_SHADOW_N8N_WEBHOOK_URL=
# Product -> n8n Header Auth secret. No Bearer; never NEXT_PUBLIC_*.
N8N_SHADOW_WEBHOOK_TOKEN=
# n8n relay credentials are distinct from the internal LangGraph S2S token
LANGGRAPH_SHADOW_RELAY_GENERATE_URL=
LANGGRAPH_SHADOW_RELAY_EXECUTE_URL=
LANGGRAPH_SHADOW_RELAY_TOKEN=
LANGGRAPH_INTERNAL_BASE_URL=http://127.0.0.1:8000
LANGGRAPH_SHADOW_TIMEOUT_MS=1500
LANGGRAPH_S2S_TOKEN=
# Required with LANGGRAPH_SHADOW_ENABLED=true. JSON array of placeholder UUID
# subjects only, optionally bound to organization_id; never use emails or names.
LANGGRAPH_SHADOW_CANARY_SUBJECTS_JSON=[]
# Required with the canary subjects. RFC3339 UTC expiry; past expiry blocks all dispatch.
LANGGRAPH_SHADOW_CANARY_EXPIRES_AT=
# Disabled by default. When enabled, requires the tenant-identity migration and
# an active persisted organization membership for every authenticated session.
AGENT_TENANT_IDENTITY_ENABLED=false
# Required only with tenant identity enabled: exact UUID bound to the
# organization whose OFFICIAL n8n datasource has been separately verified.
# This does NOT itself prove data isolation; no automatic promotion.
AGENT_TENANT_OFFICIAL_ORGANIZATION_ID=

# Manual identity onboarding: no tenant is silently provisioned.
# Restrict bootstrap to a separately verified real admin UUID; disable again
# immediately after the initial explicit human organization registration.
AGENT_TENANT_INITIAL_BOOTSTRAP_ENABLED=false
AGENT_TENANT_BOOTSTRAP_ACTOR_ID=
AGENT_TENANT_MEMBERSHIP_ADMIN_ENABLED=false

# Candidate LangGraph is independent from the official n8n flow.
# These switches are separate and default to disabled. The candidate
# requires explicit tenant selection, model parity and authorized n8n S2S.
AGENT_CANDIDATE_GENERATE_ENABLED=false
AGENT_CANDIDATE_REVIEW_ENABLED=false
AGENT_CANDIDATE_EXECUTION_REQUEST_ENABLED=false
AGENT_CANDIDATE_AUTHORIZED_ORGANIZATION_ID=
N8N_CANDIDATE_GENERATE_WEBHOOK_URL=
N8N_CANDIDATE_GENERATE_TOKEN=

# Separate approved-SQL Shadow WITNESS. Does not execute financial SQL.
# Must stay disabled until operator attests target LangGraph runtime has
# LANGGRAPH_ALLOW_REAL_SQL_EXECUTION=false, verifies S2S, and approves cost.
AGENT_CANDIDATE_SHADOW_WITNESS_ENABLED=false
AGENT_CANDIDATE_SHADOW_WITNESS_NO_EXECUTION_ATTESTED=false
N8N_CANDIDATE_SHADOW_WITNESS_WEBHOOK_URL=
N8N_CANDIDATE_SHADOW_WITNESS_TOKEN=
# There is intentionally NO candidate real-execution flag or executor here.
# An approved SQL review and pending request do not authorize SQL execution.
# Separate read-only evidence relay over n8n, not the generation webhook.
# Does not enable Shadow generation. Configure only after separate approval.
LANGGRAPH_SHADOW_EVIDENCE_TRANSPORT=direct
LANGGRAPH_SHADOW_EVIDENCE_N8N_WEBHOOK_URL=
N8N_SHADOW_EVIDENCE_WEBHOOK_TOKEN=
LANGGRAPH_SHADOW_EVIDENCE_TIMEOUT_MS=5000

AGENT_INTERFACE_MODE=demo
AGENT_VERSION=
AGENT_SOURCE=

# Habilita a gestão visual de políticas. Manter false em demos para cliente.
PROFILE_POLICY_MANAGEMENT_ENABLED=false
NEXT_PUBLIC_PROFILE_POLICY_MANAGEMENT_ENABLED=false

# Valores opcionais para estimar custo de IA. Informar custo por 1 milhão de tokens.
LLM_INPUT_COST_PER_1M_TOKENS_USD=
LLM_OUTPUT_COST_PER_1M_TOKENS_USD=

NEXT_PUBLIC_APP_NAME=Agente Financeiro
